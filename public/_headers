# Static files keep their names between deploys, so they can't be cached forever like /assets/*.
# A day without asking the server, then the cached copy is used at once while a fresh one is fetched.
# Story cards are generated HTML from remote data: never run scripts, even on direct navigation.
# Allow framing by 'self' and Whop (the app runs inside whop.com's iframe on kuletxai.whop.site).
# Note: this file only covers static assets. SSR pages get headers from src/server.ts.
/isk/:story/cards/*
  Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; img-src 'self' data: https:; media-src 'self' https:; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'self' https://whop.com https://*.whop.com; script-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
/covers/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/soft/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/tiles/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/titles/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/trimz/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/isk/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/brand/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/fonts/*
