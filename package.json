{
  "name": "kuletxai",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "vite build",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "whop apps deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
